<linker>
  <!-- WebShellBridge sets WebGLInput.captureAllKeyboardInput by reflection (Unity 6000.0 does not let
       scripts reference UnityEngine.WebGLModule), so keep the type from being stripped in Web builds. -->
  <assembly fullname="UnityEngine.WebGLModule" ignoreIfMissing="1">
    <type fullname="UnityEngine.WebGLInput" preserve="all"/>
  </assembly>
  <!-- GameObject.CreatePrimitive(Capsule) adds a CapsuleCollider natively; without this, engine code
       stripping removes the class and the Web build logs "class 'CapsuleCollider' doesn't exist". -->
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.CapsuleCollider" preserve="all"/>
  </assembly>
</linker>
